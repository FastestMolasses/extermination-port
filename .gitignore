# Build output
build/
*.o
*.obj
*.app
*.exe
*.pdb
*.dSYM/
__pycache__/
*.py[cod]

# Disc-derived material — NEVER commit (see CLAUDE.md). The port consumes the
# user's own decompiled code + their own legally-dumped disc assets at build
# time; none of it is redistributed here.
assets/
data/
*.iso
*.bin
*.BIN
*.dat
*.DAT

# Local scratch captures (renders sample disc-derived textures — never ship)
scratch_noassets/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Runtime-input symlinks in isolated worktrees.
/assets
/data

# iOS (docs/IOS.md): Xcode's per-user state when the project is opened in
# the IDE. The build products (build/ios/, and the app bundles in Xcode's
# DerivedData outside the repository) contain the user's disc data.
xcuserdata/
*.xcodeproj/project.xcworkspace/
